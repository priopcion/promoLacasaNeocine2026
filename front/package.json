{
  "name": "vuexy-angular-admin-template",
  "version": "8.2.1",
  "scripts": {
    "ng": "ng",
    "start": "set NODE_OPTIONS=--max_old_space_size=8192 & ng serve --open",
    "start-hmr": "ng serve --configuration hmr --source-map=false --hmr-warning=false",
    "start-hmr-sourcemaps": "ng serve --configuration hmr --source-map=true --hmr-warning=false",
    "build": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build",
    "build-stats": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --stats-json",
    "build:prod": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production",
    "build:prod-stats": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --stats-json",
    "bundle-analyzer": "webpack-bundle-analyzer dist/vuexy/stats.json",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "14.1.0",
    "@angular/cdk": "12.0.4",
    "@angular/common": "14.1.0",
    "@angular/compiler": "14.1.0",
    "@angular/core": "14.1.0",
    "@angular/flex-layout": "12.0.0-beta.34",
    "@angular/forms": "14.1.0",
    "@angular/localize": "14.1.0",
    "@angular/platform-browser": "14.1.0",
    "@angular/platform-browser-dynamic": "14.1.0",
    "@angular/router": "14.1.0",
    "@ctrl/ngx-rightclick": "4.0.0",
    "@ng-bootstrap/ng-bootstrap": "11.0.0-rc.0",
    "@ng-select/ng-select": "6.1.0",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@swimlane/ngx-datatable": "19.0.0",
    "apexcharts": "^3.36.3",
    "autoprefixer": "10.4.5",
    "bootstrap": "4.6.1",
    "core-js": "3.14.0",
    "device-detector-js": "^3.0.3",
    "feather-icons": "4.28.0",
    "flatpickr": "4.6.9",
    "hammerjs": "2.0.8",
    "lodash": "4.17.21",
    "ng-apexcharts": "1.5.8",
    "ng-block-ui": "3.0.2",
    "ng2-flatpickr": "9.0.0",
    "ngx-dropzone": "^3.1.0",
    "ngx-perfect-scrollbar": "10.1.1",
    "ngx-toastr": "14.0.0",
    "node-waves": "0.7.6",
    "rxjs": "6.6.0",
    "sweetalert2": "^11.7.3",
    "tslib": "2.2.0",
    "zone.js": "0.11.4"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.10",
    "@angular/cli": "14.1.0",
    "@angular/compiler-cli": "14.1.0",
    "@angular/language-service": "14.1.0",
    "@angularclass/hmr": "3.0.0",
    "@types/jasmine": "3.6.3",
    "@types/node": "12.11.1",
    "codelyzer": "^6.0.2",
    "jasmine-core": "3.7.0",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage": "2.0.3",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "4.0.0",
    "karma-jasmine-html-reporter": "1.5.0",
    "sharp": "^0.34.5",
    "typescript": "4.7.4",
    "webpack-bundle-analyzer": "4.4.2"
  }
}
